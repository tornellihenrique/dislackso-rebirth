<!doctype html>
<html lang="{{.Lang}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{.Subject}}</title>
  </head>
  <body style="margin:0;padding:24px;background:#f2f3f5;font-family:Inter,Segoe UI,Helvetica,Arial,sans-serif;color:#313338;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:8px;">
      <tr>
        <td style="padding:32px;">
          <p style="margin:0 0 16px;font-size:16px;">{{.Greeting}}</p>
          <p style="margin:0 0 24px;font-size:16px;line-height:1.5;">{{.Intro}}</p>
          {{- if .Link}}
          <p style="margin:0 0 24px;">
            <a href="{{.Link}}" style="display:inline-block;padding:12px 20px;background:#5b6cf0;color:#ffffff;text-decoration:none;border-radius:4px;font-weight:600;">{{.Action}}</a>
          </p>
          <p style="margin:0 0 24px;font-size:13px;color:#5c5e66;word-break:break-all;">{{.Link}}</p>
          {{- end}}
          {{- if .Outro}}
          <p style="margin:0 0 24px;font-size:14px;line-height:1.5;color:#5c5e66;">{{.Outro}}</p>
          {{- end}}
          <p style="margin:0;font-size:13px;color:#5c5e66;">{{.Instance}}</p>
        </td>
      </tr>
    </table>
  </body>
</html>
